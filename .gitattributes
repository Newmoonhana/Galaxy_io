# Attribute macros must be defined in the .gitattributes file at the
# top level of the working tree (this repo's root is Galaxy_io_parent/,
# not Galaxy_io/), otherwise Git silently rejects them ("not allowed").
#
# These macros back the unity-yaml/unity-json/lfs attributes used by
# Galaxy_io/.gitattributes. Keep them in sync with that file.
[attr]lfs               filter=lfs diff=lfs merge=lfs -text
[attr]unity-json        eol=lf linguist-language=json
[attr]unity-yaml        merge=unityyamlmerge eol=lf linguist-language=yaml
