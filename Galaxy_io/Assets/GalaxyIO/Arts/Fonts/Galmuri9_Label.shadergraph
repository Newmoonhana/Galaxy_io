{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b17eae07921b492bb2aa4380c1b0d24f",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "EmissionPulse (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -600.0,
            "y": 950.0,
            "width": 0.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "ea33b08a8a3d42c595746b71455b0f26"
        },
        {
            "m_Id": "cbedcad1b18e45258c646ad13b53b1e1"
        },
        {
            "m_Id": "50bc66e7f96c48b6af8dde716e88f912"
        },
        {
            "m_Id": "8a51df7350c54a8fbf3aeee469d567bc"
        },
        {
            "m_Id": "ea9577501f154d88b886727b19ae69d5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "EmissionPulse",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 레이더 RimBloom(RadarBackgroundFunctions.hlsl)과 같은 식·같은 셰이더 시간이라 위상이 맞음.\n// Min == Max 이면 정확히 Min (기본 1 → 기존 출력과 같음). lerp 대신 풀어 써서 1 이 반올림 없이 유지됨.\nfloat pulse = 0.5 - 0.5 * cos(Time * Speed * 6.28318530718);\nFactor = Min + (Max - Min) * pulse;"
}

