{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "177efcaa75424c98895b935fb4682183",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "HeatBarShimmer (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -150.0,
            "y": 300.0,
            "width": 0.0,
            "height": 0.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "d3ec65f4d5984784a11aceea59e850e2"
        },
        {
            "m_Id": "ea7cfd281fac4934ab95b8f636d848a5"
        },
        {
            "m_Id": "7fe3efaac96043c39834fb95d1a75e58"
        },
        {
            "m_Id": "891da72e24e2485d9d09c8645d42f4e4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "HeatBarShimmer",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "// 화면(sRGB) 값에 더함. 선형 공간에서 더하면 어두운 채널일수록 화면에서 크게 보여 세기가 색마다 달라짐.\n// Shimmer 1 = 화면 값 +255. Strength 0 이면 Base 그대로.\nfloat3 add = Shimmer * Strength;\nOut = IsGammaSpace() ? Base + add : SRGBToLinear(LinearToSRGB(max(Base, 0.0)) + add);"
}

