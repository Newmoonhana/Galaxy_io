{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "ff10842132784d18961b34643ab374c3",
    "m_Title": "Particle-EnergyDust",
    "m_Content": "에너지 가루. 속도 방향으로 늘어난 선분. 길이 = MaxLength * Min(1, 속력 / MaxSpeed), 굵기 = Size.x.\n파티클 렌더러 Render Mode: Billboard.\nCustom Vertex Streams: Position, Color, UV, Center (TEXCOORD0.zw|x), Velocity (TEXCOORD1.yzw), Size.x (TEXCOORD2.x)",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
