{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "23af7ff8baff4b18a1ecc2c9538830b6",
    "m_Title": "Additive (@HACK_AI)",
    "m_Content": "가산 합성 근사. Canvas 타깃 블렌드가 프리멀티플라이드(Blend One OneMinusSrcAlpha, rgb *= alpha) 고정이라\nRadarCommon.hlsl 의 RadarAdditive 가 알파 1/1024, 색 x1024 로 출력함. 색은 그대로 더해지고 뒤 배경은 0.1% 만 어두워짐.\n전체 밝기는 Image 색(알파 포함)으로 조절.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -100.0,
        "y": -200.0,
        "width": 460.0,
        "height": 150.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

