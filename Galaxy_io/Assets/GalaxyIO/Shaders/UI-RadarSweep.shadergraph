{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "1a538ea4b393453597d8fc47cdeabd16",
    "m_Title": "UI-RadarSweep",
    "m_Content": "레이더 빔, 잔상 부채꼴, 빔 가장자리, 외곽 호, 탐지 거리 링.\n_Angle, _SweepAlpha, _RangeRadius 는 RadarView 가 채움. _Radius 는 RadarView 가 읽음.",
    "m_TextSize": 0,
    "m_Theme": 0,
