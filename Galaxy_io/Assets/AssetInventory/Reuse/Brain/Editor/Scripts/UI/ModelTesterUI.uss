.brain-model-tester-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgb(56, 56, 56);
    color: rgb(210, 210, 210);
}

.brain-model-tester-light {
    background-color: rgb(194, 194, 194);
    color: rgb(35, 35, 35);
}

.brain-model-tester-header {
    flex-shrink: 0;
    padding: 14px 16px 12px 16px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.10);
}

.brain-model-tester-light .brain-model-tester-header {
    border-bottom-color: rgba(0, 0, 0, 0.15);
}

.brain-model-tester-title {
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 3px;
}

.brain-model-tester-subtitle,
.brain-model-tester-status,
.brain-model-tester-model-meta,
.brain-model-tester-cell-time,
.brain-model-tester-image-name {
    color: rgb(170, 170, 170);
}

.brain-model-tester-light .brain-model-tester-subtitle,
.brain-model-tester-light .brain-model-tester-status,
.brain-model-tester-light .brain-model-tester-model-meta,
.brain-model-tester-light .brain-model-tester-cell-time,
.brain-model-tester-light .brain-model-tester-image-name {
    color: rgb(85, 85, 85);
}

.brain-model-tester-body {
    flex-grow: 1;
    min-height: 0;
    padding: 10px 12px 8px 12px;
}

.brain-model-tester-matrix {
    flex-grow: 1;
    min-height: 180px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.13);
    border-radius: 4px;
}

.brain-model-tester-light .brain-model-tester-matrix {
    border-color: rgba(0, 0, 0, 0.20);
}

.brain-model-tester-matrix-content {
    flex-direction: column;
}

.brain-model-tester-matrix-header,
.brain-model-tester-matrix-row {
    flex-direction: row;
    flex-shrink: 0;
}

.brain-model-tester-matrix-header {
    background-color: rgba(255, 255, 255, 0.035);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.12);
}

.brain-model-tester-light .brain-model-tester-matrix-header {
    background-color: rgba(0, 0, 0, 0.035);
    border-bottom-color: rgba(0, 0, 0, 0.16);
}

.brain-model-tester-matrix-row {
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.07);
}

.brain-model-tester-light .brain-model-tester-matrix-row {
    border-bottom-color: rgba(0, 0, 0, 0.10);
}

.brain-model-tester-corner,
.brain-model-tester-row-header,
.brain-model-tester-column-header,
.brain-model-tester-cell {
    padding: 8px;
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
}

.brain-model-tester-light .brain-model-tester-corner,
.brain-model-tester-light .brain-model-tester-row-header,
.brain-model-tester-light .brain-model-tester-column-header,
.brain-model-tester-light .brain-model-tester-cell {
    border-right-color: rgba(0, 0, 0, 0.11);
}

.brain-model-tester-corner-content,
.brain-model-tester-model-header,
.brain-model-tester-image-header,
.brain-model-tester-cell-content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.brain-model-tester-corner-content {
    justify-content: flex-end;
}

.brain-model-tester-corner-title,
.brain-model-tester-model-name {
    -unity-font-style: bold;
}

.brain-model-tester-corner-copy {
    white-space: normal;
    margin-top: 3px;
}

.brain-model-tester-image-header {
    align-items: center;
}

.brain-model-tester-image-toggle,
.brain-model-tester-model-toggle {
    margin: 0 0 4px 0;
}

.brain-model-tester-image-preview {
    width: 76px;
    height: 76px;
    flex-shrink: 0;
    margin-bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.brain-model-tester-image-name {
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 190px;
}

.brain-model-tester-model-header {
    justify-content: center;
}

.brain-model-tester-model-heading {
    flex-direction: row;
    align-items: flex-start;
}

.brain-model-tester-model-name {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.brain-model-tester-model-meta {
    margin-left: 21px;
    margin-top: 4px;
}

.brain-model-tester-cell-disabled {
    opacity: 0.45;
    justify-content: center;
    align-items: center;
}

.brain-model-tester-caption {
    flex-grow: 1;
    min-height: 0;
    white-space: normal;
    padding: 5px 6px;
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 3px;
}

.brain-model-tester-light .brain-model-tester-caption {
    background-color: rgba(255, 255, 255, 0.28);
}

.brain-model-tester-cell-actions {
    flex-direction: row;
    align-items: center;
    margin-top: 6px;
}

.brain-model-tester-cell-run {
    width: 28px;
    height: 22px;
    padding: 2px;
    flex-shrink: 0;
}

.brain-model-tester-cell-run > Image {
    width: 14px;
    height: 14px;
    align-self: center;
}

.brain-model-tester-cell-time {
    margin-left: 7px;
}

.brain-model-tester-prompt {
    flex-shrink: 0;
    margin-top: 8px;
    padding: 0 8px 6px 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.11);
    border-radius: 4px;
}

.brain-model-tester-light .brain-model-tester-prompt {
    border-color: rgba(0, 0, 0, 0.17);
}

.brain-model-tester-prompt-body {
    flex-direction: row;
    flex-shrink: 0;
    min-width: 0;
    min-height: 120px;
    padding-top: 4px;
}

.brain-model-tester-prompt-column {
    flex-basis: 0;
    flex-grow: 1;
    min-width: 220px;
}

.brain-model-tester-prompt-custom {
    margin-left: 8px;
}

.brain-model-tester-prompt-heading {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.brain-model-tester-prompt-label {
    flex-grow: 1;
    -unity-font-style: bold;
}

.brain-model-tester-prompt-field {
    min-height: 96px;
    flex-grow: 1;
}

.brain-model-tester-prompt-readonly {
    height: 96px;
    min-height: 96px;
    padding: 5px 6px;
    background-color: rgba(0, 0, 0, 0.12);
    border-radius: 3px;
}

.brain-model-tester-prompt-readonly Label {
    white-space: normal;
}

.brain-model-tester-light .brain-model-tester-prompt-readonly {
    background-color: rgba(255, 255, 255, 0.28);
}

.brain-model-tester-prompt-field .unity-text-input {
    white-space: normal;
}

.brain-model-tester-footer {
    justify-content: flex-start;
}

.brain-model-tester-status {
    flex-grow: 1;
    min-width: 0;
    white-space: normal;
}

.brain-model-tester-progress {
    width: 220px;
    margin-left: 8px;
    margin-right: 8px;
}

.brain-model-tester-action {
    min-width: 145px;
    height: 28px;
    margin-left: 6px;
}

.brain-model-tester-primary {
    background-color: rgb(50, 105, 170);
    border-color: rgb(65, 130, 210);
    color: white;
    -unity-font-style: bold;
}

.brain-model-tester-empty {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 24px;
}

.brain-model-tester-empty-copy {
    max-width: 520px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.brain-model-tester-compact .brain-model-tester-prompt-body {
    flex-direction: column;
    min-height: 170px;
}

.brain-model-tester-compact .brain-model-tester-matrix {
    min-height: 140px;
}

.brain-model-tester-compact .brain-model-tester-prompt-column {
    min-width: 0;
}

.brain-model-tester-compact .brain-model-tester-prompt-custom {
    margin-left: 0;
    margin-top: 8px;
}

.brain-model-tester-compact .brain-model-tester-prompt-field,
.brain-model-tester-compact .brain-model-tester-prompt-readonly {
    height: 58px;
    min-height: 58px;
}

.brain-model-tester-compact .brain-model-tester-footer {
    flex-wrap: wrap;
}

.brain-model-tester-compact .brain-model-tester-status {
    width: 100%;
    flex-basis: 100%;
    margin-bottom: 6px;
}

.brain-model-tester-compact .brain-model-tester-progress {
    flex-grow: 1;
    width: auto;
    min-width: 140px;
    margin-left: 0;
}
