.automator-inspector {
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    min-width: 0;
}

.automator-action-manager > .chart-guru-inspector__header {
    margin-bottom: 8px;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
}

.automator-step-header,
.automator-step-card__header,
.automator-action-row,
.automator-file-toolbar {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.automator-step-header {
    min-height: 28px;
    margin-bottom: 5px;
}

.automator-step-list {
    min-height: 160px;
    max-height: 520px;
}

.automator-step-card,
.automator-action-row {
    margin-bottom: 5px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 8px;
    padding-bottom: 8px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.28);
    border-radius: 4px;
    background-color: rgba(128, 128, 128, 0.06);
}

.automator-step-card__header {
    margin-bottom: 7px;
}

.automator-step-card__title,
.automator-action-row__title {
    -unity-font-style: bold;
    font-size: 13px;
}

.automator-step-card .unity-base-field {
    margin-bottom: 4px;
}

.automator-action-list {
    flex-grow: 1;
    min-height: 0;
    margin-top: 7px;
}

.common-inspector-section .automator-step-card,
.common-inspector-section .automator-action-row {
    border-width: 0;
}

.automator-file-toolbar {
    min-height: 28px;
    margin-bottom: 5px;
}

.automator-empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    min-height: 180px;
}

.automator-empty__title {
    -unity-font-style: bold;
    font-size: 15px;
    margin-bottom: 4px;
}

.automator-inspector.common-inspector--compact .automator-step-card__header,
.automator-inspector.common-inspector--compact .automator-action-row {
    flex-direction: column;
    align-items: stretch;
}
