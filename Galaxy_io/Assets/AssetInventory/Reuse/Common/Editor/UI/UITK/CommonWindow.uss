/* Window chrome owns the viewport; spacing belongs to the content inside it. */
.common-window-root {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.common-window-root > * {
    margin-left: 8px;
    margin-right: 8px;
}

.common-window-root > .unity-scroll-view,
.common-window-root > .unity-collection-view,
.common-window-root > .unity-toolbar,
.common-window-root > .unity-two-pane-split-view,
.common-window-root > .common-window-body,
.common-window-root > .common-window-footer {
    margin-left: 0;
    margin-right: 0;
}

.common-window-root > .unity-scroll-view {
    min-width: 0;
    min-height: 0;
    padding-left: 0;
    padding-right: 0;
    padding-bottom: 0;
}

.common-window-root > .unity-scroll-view > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container,
.common-window-root > .unity-scroll-view > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container {
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
}
