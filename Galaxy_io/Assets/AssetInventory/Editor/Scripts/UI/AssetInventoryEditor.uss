    border-left-color: rgba(81, 142, 220, 0.65);
    border-right-color: rgba(81, 142, 220, 0.28);
    border-top-color: rgba(81, 142, 220, 0.28);
    border-bottom-color: rgba(81, 142, 220, 0.28);
    background-color: rgba(81, 142, 220, 0.14);
}

.ai-choice-card-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.ai-choice-card-copy {
    white-space: normal;
    margin-bottom: 3px;
}

.ai-choice-card-meta {
    -unity-text-align: middle-center;
    margin-top: 7px;
    margin-bottom: 6px;
}

.ai-choice-card-footer {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    min-height: 24px;
}

.ai-welcome-root {
    min-width: 420px;
    min-height: 300px;
}

.ai-compact-search-toolbar .ai-button,
.ai-compact-search-toolbar .unity-toolbar-search-field,
.ai-compact-search-toolbar .unity-base-popup-field,
.ai-compact-search-toolbar .ai-navigation-footer-segment-button {
    height: 24px;
    min-height: 24px;
}

.ai-compact-search-toolbar .unity-base-popup-field > .unity-base-field__input {
    height: 24px;
    min-height: 24px;
}
