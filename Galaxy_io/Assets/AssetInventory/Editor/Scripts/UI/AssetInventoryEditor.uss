.ai-uitk-root {
    flex-grow: 1;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.ai-uitk-dark {
    background-color: rgb(56, 56, 56);
    color: rgb(220, 220, 220);
}

.ai-uitk-light {
    background-color: rgb(222, 222, 222);
    color: rgb(35, 35, 35);
}

.ai-logo-header {
    align-items: center;
    justify-content: center;
}

.ai-logo-header-image {
    margin-bottom: 4px;
}

.ai-section {
    min-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(255, 255, 255, 0.04);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 9px;
    padding-bottom: 9px;
    margin-bottom: 8px;
}

.ai-section .ai-section,
.ai-section .ai-choice-card,
.ai-section .ai-settings-group,
.ai-custom-preview-group .ai-section {
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
}

.ai-uitk-light .ai-section {
    border-left-color: rgba(0, 0, 0, 0.16);
    border-right-color: rgba(0, 0, 0, 0.16);
    border-top-color: rgba(0, 0, 0, 0.16);
    border-bottom-color: rgba(0, 0, 0, 0.16);
    background-color: rgba(255, 255, 255, 0.36);
}

.ai-section-title {
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.ai-section-copy {
    min-width: 0;
    white-space: normal;
    flex-shrink: 1;
}

.ai-help-box {
    flex-direction: row;
    align-items: flex-start;
    min-width: 0;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-left-width: 3px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    padding-left: 8px;
    padding-right: 9px;
    padding-top: 8px;
    padding-bottom: 8px;
    margin-top: 4px;
    margin-bottom: 8px;
}

.ai-help-box-info {
    border-left-color: rgb(81, 142, 220);
    border-right-color: rgba(81, 142, 220, 0.30);
    border-top-color: rgba(81, 142, 220, 0.30);
    border-bottom-color: rgba(81, 142, 220, 0.30);
    background-color: rgba(81, 142, 220, 0.13);
}

.ai-uitk-light .ai-help-box-info {
    border-right-color: rgba(41, 103, 186, 0.30);
    border-top-color: rgba(41, 103, 186, 0.30);
    border-bottom-color: rgba(41, 103, 186, 0.30);
    background-color: rgba(41, 103, 186, 0.10);
}

.ai-help-box-warning {
    border-left-color: rgb(224, 164, 74);
    border-right-color: rgba(224, 164, 74, 0.32);
    border-top-color: rgba(224, 164, 74, 0.32);
    border-bottom-color: rgba(224, 164, 74, 0.32);
    background-color: rgba(224, 164, 74, 0.14);
}

.ai-uitk-light .ai-help-box-warning {
    background-color: rgba(184, 114, 30, 0.12);
}

.ai-help-box-error {
    border-left-color: rgb(218, 89, 82);
    border-right-color: rgba(218, 89, 82, 0.34);
    border-top-color: rgba(218, 89, 82, 0.34);
    border-bottom-color: rgba(218, 89, 82, 0.34);
    background-color: rgba(218, 89, 82, 0.14);
}

.ai-uitk-light .ai-help-box-error {
    background-color: rgba(188, 54, 48, 0.11);
}

.ai-help-box-neutral {
    border-left-color: rgb(128, 128, 128);
    border-right-color: rgba(255, 255, 255, 0.14);
    border-top-color: rgba(255, 255, 255, 0.14);
    border-bottom-color: rgba(255, 255, 255, 0.14);
    background-color: rgba(255, 255, 255, 0.05);
}

.ai-help-box-icon {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-right: 7px;
    margin-top: 1px;
}

.ai-help-box-text {
    min-width: 0;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

.ai-key-value-row {
    flex-direction: row;
    min-width: 0;
    margin-bottom: 4px;
}

.ai-key-value-label {
    -unity-font-style: bold;
    min-width: 115px;
    margin-right: 8px;
}

.ai-key-value-text {
    min-width: 0;
    white-space: normal;
    flex-grow: 1;
    flex-shrink: 1;
}

.ai-field-row {
    flex-direction: row;
    align-items: center;
    min-width: 0;
    margin-top: 4px;
    margin-bottom: 4px;
}

.ai-field-label {
    -unity-font-style: bold;
    min-width: 120px;
    margin-right: 8px;
}

.ai-field-control {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.ai-window-search-field {
    align-self: stretch;
    width: auto;
    min-width: 0;
    max-width: none;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    flex-shrink: 1;
}

.ai-standalone-search-field {
    margin-top: 4px;
    margin-bottom: 8px;
}

.ai-inspector-pane {
    min-width: 0;
    min-height: 0;
    background-color: rgba(46, 46, 46, 0.98);
    border-left-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.12);
}

.ai-resizable-pane-layout {
    flex-direction: row;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ai-resizable-pane-main {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
}

.ai-resizable-pane-host {
    position: relative;
    flex-shrink: 0;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.ai-resizable-pane-leading {
    padding-right: 8px;
}

.ai-resizable-pane-trailing {
    padding-left: 8px;
}

.ai-resizable-pane-content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ai-resizable-pane-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 8px;
    align-items: center;
    justify-content: center;
    cursor: resize-horizontal;
}

.ai-resizable-pane-divider-line {
    width: 1px;
    height: 100%;
    background-color: transparent;
}

.ai-resizable-pane-divider:hover .ai-resizable-pane-divider-line,
.ai-resizable-pane-divider:focus .ai-resizable-pane-divider-line,
.ai-resizable-pane-resizing .ai-resizable-pane-divider-line {
    width: 2px;
    background-color: rgb(69, 142, 235);
}

.ai-resizable-pane-collapsed {
    background-color: rgba(55, 105, 175, 0.08);
}

.ai-resizable-pane-collapsed .ai-resizable-pane-divider-line {
    width: 2px;
    height: 42px;
    background-color: rgba(79, 151, 240, 0.68);
    border-top-left-radius: 1px;
    border-top-right-radius: 1px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
}

.ai-resizable-pane-content > .ai-inspector-pane {
    border-left-width: 0;
}

.ai-resizable-pane-compact .ai-field-row,
.ai-resizable-pane-compact .ai-key-value-row,
.ai-resizable-pane-compact .ai-package-detail-row {
    flex-direction: column;
    align-items: stretch;
}

.ai-resizable-pane-compact .ai-field-label,
.ai-resizable-pane-compact .ai-key-value-label,
.ai-resizable-pane-compact .ai-package-detail-label {
    width: auto;
    min-width: 0;
    margin-right: 0;
    margin-bottom: 3px;
}

.ai-resizable-pane-compact .ai-package-detail-actions.ai-package-detail-action-grid > .ai-package-detail-action-item {
    width: 100%;
}

.ai-resizable-pane-wide .ai-package-detail-actions > .ai-advanced-visibility-block {
    min-width: 160px;
}

.ai-uitk-light .ai-inspector-pane {
    background-color: rgba(218, 218, 218, 0.98);
    border-left-color: rgba(0, 0, 0, 0.18);
}

.ai-inspector-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 34px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.10);
}

.ai-uitk-light .ai-inspector-header {
    border-bottom-color: rgba(0, 0, 0, 0.16);
}

.ai-inspector-leading,
.ai-inspector-trailing,
.ai-inspector-tabs {
    flex-direction: row;
    align-items: center;
    min-width: 0;
}

.ai-inspector-tabs {
    flex-grow: 1;
    justify-content: center;
}

.ai-inspector-tab {
    flex-grow: 1;
    min-width: 0;
    height: 29px;
    margin-left: 1px;
    margin-right: 1px;
    margin-top: 2px;
    margin-bottom: 0;
    padding-left: 6px;
    padding-right: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(180, 180, 180);
}

.ai-inspector-tab:hover {
    background-color: rgba(255, 255, 255, 0.05);
    color: rgb(225, 225, 225);
}

.ai-inspector-tab-selected {
    -unity-font-style: bold;
    color: rgb(232, 232, 232);
    border-bottom-color: rgb(74, 144, 236);
    background-color: rgba(74, 144, 236, 0.08);
}

.ai-uitk-light .ai-inspector-tab {
    color: rgb(76, 76, 76);
}

.ai-uitk-light .ai-inspector-tab:hover {
    color: rgb(28, 28, 28);
    background-color: rgba(0, 0, 0, 0.05);
}

.ai-uitk-light .ai-inspector-tab-selected {
    color: rgb(25, 25, 25);
    border-bottom-color: rgb(42, 108, 200);
    background-color: rgba(42, 108, 200, 0.08);
}

.ai-inspector-body {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.ai-searchable-popup {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ai-searchable-popup-button {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.ai-searchable-popup-label {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.ai-searchable-popup-arrow {
    flex-shrink: 0;
}

.ai-status-pill {
    flex-shrink: 1;
    min-width: 0;
    max-width: 100%;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-height: 22px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
    padding-left: 9px;
    padding-right: 9px;
    padding-top: 2px;
    padding-bottom: 2px;
    color: rgb(206, 232, 204);
    background-color: rgba(83, 150, 91, 0.22);
}

.ai-status-muted {
    color: rgb(210, 210, 210);
    background-color: rgba(255, 255, 255, 0.08);
}

.ai-status-pill.ai-field-control {
    flex-grow: 0;
    flex-shrink: 1;
    align-self: center;
}

.ai-removable-pill {
    flex-direction: row;
    flex-shrink: 1;
    align-items: center;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
}

.ai-removable-pill-text {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.ai-removable-pill-icon {
    width: 14px;
    min-width: 14px;
    height: 14px;
    margin-left: 4px;
    opacity: 0;
}

.ai-removable-pill:hover .ai-removable-pill-icon,
.ai-removable-pill:focus .ai-removable-pill-icon {
    opacity: 1;
}

.ai-advanced-visibility-block {
    min-width: 0;
    flex-shrink: 0;
}

.ai-advanced-visibility-body {
    min-width: 0;
}

.ai-advanced-visibility-inline {
    flex-direction: row;
    align-items: center;
}

.ai-advanced-visibility-controls {
    flex-direction: row;
    justify-content: flex-end;
    position: absolute;
    right: 3px;
    top: 3px;
}

.ai-advanced-visibility-controls-inline {
    position: relative;
    right: auto;
    top: auto;
    margin-left: 3px;
}

.ai-advanced-visibility-toggle {
    min-width: 68px;
    min-height: 20px;
    padding-left: 6px;
    padding-right: 6px;
    padding-top: 0;
    padding-bottom: 0;
}

.ai-advanced-visibility-toggle-shown {
    -unity-font-style: bold;
}

.ai-advanced-visibility-toggle-advanced {
    opacity: 0.78;
}

.ai-advanced-visibility-toggle-compact {
    width: 22px;
    min-width: 22px;
    height: 22px;
    min-height: 22px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.ai-advanced-visibility-toggle-icon {
    width: 14px;
    height: 14px;
    align-self: center;
}

.ai-advanced-visibility-default {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(118, 160, 216, 0.62);
    border-right-color: rgba(118, 160, 216, 0.62);
    border-top-color: rgba(118, 160, 216, 0.62);
    border-bottom-color: rgba(118, 160, 216, 0.62);
    background-color: rgba(118, 160, 216, 0.08);
    padding-left: 3px;
    padding-right: 78px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ai-advanced-visibility-advanced {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 150, 150, 0.58);
    border-right-color: rgba(150, 150, 150, 0.58);
    border-top-color: rgba(150, 150, 150, 0.58);
    border-bottom-color: rgba(150, 150, 150, 0.58);
    background-color: rgba(150, 150, 150, 0.06);
    padding-left: 3px;
    padding-right: 78px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ai-advanced-visibility-default.ai-advanced-visibility-inline,
.ai-advanced-visibility-advanced.ai-advanced-visibility-inline {
    padding-right: 3px;
}

.ai-ordered-section {
    min-width: 0;
    flex-shrink: 0;
}

.ai-ordered-section-body {
    min-width: 0;
}

.ai-ordered-section-customizing {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(150, 150, 150, 0.58);
    border-right-color: rgba(150, 150, 150, 0.58);
    border-top-color: rgba(150, 150, 150, 0.58);
    border-bottom-color: rgba(150, 150, 150, 0.58);
    background-color: rgba(150, 150, 150, 0.06);
    padding-left: 4px;
    padding-right: 56px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ai-ordered-section-controls {
    flex-direction: row;
    justify-content: flex-end;
    position: absolute;
    right: 3px;
    top: 3px;
}

.ai-ordered-section-move {
    width: 22px;
    min-width: 22px;
    height: 22px;
    min-height: 22px;
    margin-left: 2px;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-left-radius: 11px;
    border-top-right-radius: 11px;
    border-bottom-left-radius: 11px;
    border-bottom-right-radius: 11px;
}

.ai-dialog-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    margin-bottom: 8px;
}

.ai-footer {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 8px;
}

.ai-navigation-footer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    min-height: 34px;
    margin-top: 6px;
    padding-top: 3px;
    padding-bottom: 2px;
}

.ai-navigation-footer-group {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    min-width: 0;
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 3px;
}

.ai-navigation-footer-left {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    justify-content: flex-start;
}

.ai-navigation-footer-center {
    flex-grow: 0;
    flex-shrink: 0;
}

.ai-navigation-footer-right {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    justify-content: flex-end;
}

.ai-search-footer {
    flex-wrap: nowrap;
    justify-content: flex-start;
}

.ai-search-footer .ai-navigation-footer-left {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0;
    min-width: 0;
    flex-wrap: nowrap;
}

.ai-search-footer .ai-navigation-footer-center {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    min-width: 0;
    justify-content: center;
}

.ai-search-footer .ai-navigation-footer-right {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.ai-packages-footer {
    flex-wrap: nowrap;
    justify-content: flex-start;
}

.ai-packages-footer .ai-navigation-footer-group {
    flex-wrap: nowrap;
}

.ai-packages-footer .ai-navigation-footer-left {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0;
    min-width: 0;
}

.ai-packages-footer .ai-navigation-footer-center {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    min-width: 0;
    justify-content: center;
}

.ai-packages-footer .ai-navigation-footer-right {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.ai-packages-footer .ai-navigation-footer-summary {
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.ai-packages-footer-minimum .ai-navigation-footer-summary {
    display: none;
}

.ai-navigation-footer-summary {
    color: rgb(174, 174, 174);
    margin-left: 6px;
    margin-right: 8px;
    -unity-text-align: middle-center;
}

.ai-navigation-footer-pager {
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    align-items: center;
    margin-left: 4px;
    margin-right: 6px;
}

.ai-navigation-footer-pager-label {
    min-width: 104px;
    min-height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    margin-left: 0;
    margin-right: 3px;
}

.ai-navigation-footer-button {
    min-width: 28px;
    min-height: 24px;
    padding-left: 7px;
    padding-right: 7px;
    margin-left: 0;
    margin-right: 3px;
}

.ai-navigation-footer-icon-button {
    width: 28px;
    min-width: 28px;
    padding-left: 0;
    padding-right: 0;
}

.ai-navigation-footer-active {
    -unity-font-style: bold;
}

.ai-navigation-footer-segmented {
    flex-direction: row;
    align-items: center;
    margin-left: 0;
    margin-right: 4px;
}

.ai-navigation-footer-segment-button {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 58px;
    height: 24px;
    min-height: 24px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 0;
    padding-bottom: 0;
    margin-left: 0;
    margin-right: -1px;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

.ai-navigation-footer-segment-first {
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
}

.ai-navigation-footer-segment-last {
    margin-right: 0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
}

.ai-navigation-footer-segmented .ai-navigation-footer-active {
    color: rgb(238, 245, 255);
    background-color: rgb(54, 112, 189);
    border-left-color: rgb(82, 154, 235);
    border-right-color: rgb(82, 154, 235);
    border-top-color: rgb(82, 154, 235);
    border-bottom-color: rgb(82, 154, 235);
}

